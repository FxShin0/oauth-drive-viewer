# Crear credenciales OAuth 2.0 de tipo "Aplicación web" en Google Cloud Console.
GOOGLE_CLIENT_ID=pegar-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=pegar-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
PORT=3000
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=reemplazar-por-un-secreto-aleatorio-largo
